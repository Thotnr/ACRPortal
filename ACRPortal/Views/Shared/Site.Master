<%@ Master Language="C#" Inherits="System.Web.Mvc.ViewMasterPage" %>

<!DOCTYPE html>
<html>
<head runat="server">
<title>ACR Portal</title>

<base href="<%= Url.Content("~/") %>" />

<link rel="icon" type="image/x-icon" href="<%= Url.Content("~/assets/image/ico/favicon.ico") %>" />

<link rel="stylesheet"
href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
var BASE_URL = '<%= Url.Content("~/") %>';
</script>

<style>

body{
margin:0;
background:
radial-gradient(circle at top right, rgba(6,182,212,0.08), transparent 24%),
linear-gradient(180deg, #f4f8fc 0%, #eef4fb 100%);
font-family:'Segoe UI',sans-serif;
color:#172033;
}

.main-layout{
display:flex;
width:100%;
min-height:calc(100vh - 78px);
}

.container, .container-fluid, .container-lg, .container-md, .container-sm, .container-xl{
padding-left:0;
}

/* HEADER */

.header{
background:rgba(255,255,255,0.88);
backdrop-filter:blur(12px);
height:78px;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 28px;
box-shadow:0 16px 30px rgba(15,23,42,0.08);
position:sticky;
top:0;
z-index:1000;
border-bottom:1px solid rgba(148,163,184,0.16);
}

.logo{
height:46px;
display:block;
filter:drop-shadow(0 8px 18px rgba(29,78,216,0.12));
}

.user-section{
display:flex;
align-items:center;
gap:14px;
}

.username{
font-weight:600;
color:#1f2a44;
padding:10px 14px;
border-radius:999px;
background:rgba(37,99,235,0.08);
border:1px solid rgba(37,99,235,0.08);
white-space:nowrap;
}

.brand-wrap{
display:flex;
align-items:center;
gap:14px;
}

.brand-copy{
display:flex;
flex-direction:column;
}

.brand-title{
font-size:18px;
font-weight:700;
line-height:1.1;
color:#102542;
}

.brand-subtitle{
font-size:12px;
font-weight:600;
letter-spacing:0.05em;
text-transform:uppercase;
color:#64748b;
}

/* SIDEBAR */

.sidebar{
background:
linear-gradient(180deg, #0f1d34 0%, #15314b 48%, #1d4ed8 100%);
min-height:calc(100vh - 78px);
width:280px;
padding:18px 14px 20px;
transition:all .3s ease;
overflow:hidden;
position:relative;
box-shadow:24px 0 45px rgba(15,23,42,0.12);
}

.sidebar:before{
content:"";
position:absolute;
top:-80px;
right:-60px;
width:180px;
height:180px;
border-radius:50%;
background:rgba(255,255,255,0.08);
border:1px solid rgba(255,255,255,0.12);
}

.sidebar.collapsed{
width:90px;
}

.sidebar.collapsed a span{
display:none;
}

.sidebar.collapsed .sidebar-title,
.sidebar.collapsed .sidebar-copy,
.sidebar.collapsed .toggle-icon{
display:none;
}

.sidebar.collapsed a{
justify-content:center;
padding:14px 0;
}

.sidebar.collapsed .menu-toggle{
justify-content:center;
padding:14px 0;
}

.sidebar-intro{
position:relative;
z-index:1;
padding:18px 16px;
margin-bottom:18px;
border-radius:22px;
background:rgba(255,255,255,0.08);
border:1px solid rgba(255,255,255,0.12);
box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);
}

.sidebar-title{
font-size:13px;
font-weight:700;
letter-spacing:0.08em;
text-transform:uppercase;
color:rgba(255,255,255,0.72);
}

.sidebar-copy{
margin-top:8px;
font-size:14px;
line-height:1.6;
color:rgba(255,255,255,0.84);
}

.sidebar a{
color:#dbe8f5;
display:flex;
align-items:center;
gap:12px;
padding:13px 16px;
font-size:15px;
font-weight:600;
transition:0.3s;
border-left:0;
border-radius:16px;
margin-bottom:6px;
position:relative;
z-index:1;
}

.sidebar a:hover{
background:rgba(255,255,255,0.1);
color:white;
text-decoration:none;
transform:translateX(2px);
}

.sidebar a.active{
background:linear-gradient(135deg, rgba(255,255,255,0.18), rgba(96,165,250,0.24));
color:white;
box-shadow:0 16px 30px rgba(15,23,42,0.18);
}

.sidebar a i,
.menu-toggle i{
width:20px;
text-align:center;
}

/* SUBMENU */

.sidebar-submenu{
max-height:0;
overflow:hidden;
transition:max-height 0.3s ease;
}

.sidebar-submenu.show{
max-height:500px;
}

.sidebar-submenu a{
padding:10px 16px 10px 46px;
font-size:14px;
color:#c6d4e2;
margin-bottom:4px;
border-radius:14px;
}

.sidebar-submenu a:hover{
background:rgba(255,255,255,0.08);
color:white;
}

.sidebar-submenu a.active{
background:rgba(96,165,250,0.22);
color:white;
}

.sidebar .menu-toggle{
cursor:pointer;
display:flex;
justify-content:space-between;
align-items:center;
padding:13px 16px;
color:#dbe8f5;
font-size:15px;
font-weight:600;
border-radius:16px;
margin-bottom:6px;
position:relative;
z-index:1;
}

.sidebar .menu-toggle:hover{
background:rgba(255,255,255,0.1);
color:white;
}

.sidebar .menu-toggle.active{
background:linear-gradient(135deg, rgba(255,255,255,0.18), rgba(96,165,250,0.24));
color:white;
box-shadow:0 16px 30px rgba(15,23,42,0.18);
}

.toggle-icon{
transition:transform .3s;
}

.menu-toggle.active .toggle-icon{
transform:rotate(180deg);
}

/* MOBILE */

@media(max-width:768px){

.main-layout{
display:block;
}

.sidebar{
position:fixed;
top:0;
left:0;
width:320px;
max-width:88vw;
height:100%;
z-index:3000;
transform:translateX(-100%);
transition:transform .3s ease;
padding-top:88px;
overflow-y:auto;
}

.sidebar.show{
transform:translateX(0);
}

.header{
padding:0 16px;
height:74px;
}

.brand-subtitle{
display:none;
}

}

.content{
flex:1;
padding:28px;
min-width:0;
}

/* LOGOUT MODAL */

.modal-header{
background:linear-gradient(135deg, #15314b, #2563eb);
color:white;
}

.sidebar-toggle{
width:46px;
height:46px;
border-radius:14px;
border:1px solid rgba(148,163,184,0.2);
background:linear-gradient(180deg, #ffffff, #eef4ff);
color:#15314b;
box-shadow:0 10px 20px rgba(15,23,42,0.08);
}

.sidebar-toggle:hover,
.sidebar-toggle:focus{
background:linear-gradient(180deg, #ffffff, #dbeafe);
color:#15314b;
}

.logout-btn{
border-radius:14px;
font-weight:700;
padding:10px 14px;
border-color:rgba(239,68,68,0.3);
}

</style>

</head>

<body>

<!-- HEADER -->

<div class="header">

<div class="brand-wrap">

<button class="btn btn-light sidebar-toggle" id="toggleSidebar">
<i class="fas fa-bars"></i>
</button>

<img src="<%= Url.Content("~/assets/image/dhbvn_logo.png") %>" class="logo"/>

<div class="brand-copy">
<span class="brand-title">ACR Portal</span>
<span class="brand-subtitle">Performance Workflow System</span>
</div>

</div>

<div class="user-section">

<span class="username" id="headerUsername">
<i class="fas fa-user-circle"></i> Welcome User
</span>

<button class="btn btn-outline-danger btn-sm logout-btn"
data-toggle="modal"
data-target="#logoutModal">

<i class="fas fa-sign-out-alt"></i> Logout

</button>

</div>

</div>


<div class="container-fluid px-0">

<div class="main-layout">

<!-- SIDEBAR -->

<div class="sidebar">


<div class="menu-toggle" id="mastersToggle">
<div>
<i class="fas fa-cogs"></i>
<span>Masters</span>
</div>
<i class="fas fa-chevron-down toggle-icon"></i>
</div>

<div class="sidebar-submenu" id="mastersSubmenu">

<a href="<%= Url.Content("~/Masters/Designation") %>" id="menuMastersDesignation">
<i class="fas fa-map"></i> <span>Designation</span>
</a>

<a href="<%= Url.Content("~/Masters/State") %>" id="menuMastersState">
<i class="fas fa-map"></i> <span>State</span>
</a>

<a href="<%= Url.Content("~/Masters/Zone") %>" id="menuMastersZone">
<i class="fas fa-globe"></i> <span>Zone</span>
</a>

<a href="<%= Url.Content("~/Masters/Circle") %>" id="menuMastersCircle">
<i class="fas fa-ring"></i> <span>Circle</span>
</a>

<a href="<%= Url.Content("~/Masters/Division") %>" id="menuMastersDivision">
<i class="fas fa-th-large"></i> <span>Division</span>
</a>

<a href="<%= Url.Content("~/Masters/SubDivision") %>" id="menuMastersSubDivision">
<i class="fas fa-th"></i> <span>SubDivision</span>
</a>

<a href="<%= Url.Content("~/Masters/AddEmployee") %>" id="menuMastersAddEmployee">
<i class="fas fa-user-plus"></i> <span>Add Employee</span>
</a>

</div>

<a href="<%= Url.Content("~/Home/Dashboard") %>" id="menuDashboard">
<i class="fas fa-tachometer-alt"></i> <span>Dashboard</span>
</a>

<a href="<%= Url.Content("~/Home/CCA") %>" id="menuCCA">
<i class="fas fa-edit"></i> <span>CCA Form</span>
</a>

<a href="<%= Url.Content("~/Home/Officer") %>" id="menuOfficer">
<i class="fas fa-user"></i> <span>Officer</span>
</a>

<a href="<%= Url.Content("~/Home/Reporting") %>" id="menuReporting">
<i class="fas fa-user"></i> <span>Reporting</span>
</a>

<a href="<%= Url.Content("~/Home/Reviewing") %>" id="menuReviewing">
<i class="fas fa-user"></i> <span>Reviewing</span>
</a>

<a href="<%= Url.Content("~/Home/Accepting") %>" id="menuAccepting">
<i class="fas fa-user"></i> <span>Accepting</span>
</a>

<%--<a href="<%= Url.Content("~/Home/Reports") %>" id="menuReports">
<i class="fas fa-chart-bar"></i> <span>Reports</span>
</a>--%>

</div>

<!-- CONTENT -->

<div class="content">
<asp:ContentPlaceHolder ID="MainContent" runat="server" />
</div>

</div>

</div>

<!-- LOGOUT MODAL -->

<div class="modal fade" id="logoutModal">

<div class="modal-dialog modal-dialog-centered">
<div class="modal-content">

<div class="modal-header">
<h5 class="modal-title">
<i class="fas fa-exclamation-circle"></i> Confirm Logout
</h5>
<button class="close" data-dismiss="modal">&times;</button>
</div>

<div class="modal-body">
Are you sure you want to logout?
</div>

<div class="modal-footer">

<button class="btn btn-secondary" data-dismiss="modal">Cancel</button>

<button class="btn btn-danger" onclick="logoutUser()">Continue</button>

</div>

</div>
</div>

</div>


<script>

$(document).ready(function(){

var token = localStorage.getItem("token");

if(!token){
window.location = BASE_URL + "Login/UserAuth";
return;
}
var role = localStorage.getItem("role");

$("#mastersToggle").hide();
$("#mastersSubmenu").hide();
$("#menuCCA").hide();
$("#menuReports").hide();
$("#menuOfficer").hide();
$("#menuReporting").hide();
$("#menuReviewing").hide();
$("#menuAccepting").hide();
$("#menuDashboard").hide();

if(role === "ADMIN"){
    // show Masters + all menus
    $("#mastersToggle").show();
    $("#mastersSubmenu").show();
    $("#menuCCA").hide();
    $("#menuReports").show();
    $("#menuDashboard").show();
}
else if(role === "CCA"){
    // only CCA menu
    $("#menuCCA").show();
    $("#mastersToggle").hide();
    $("#menuReports").hide();
    $("#menuDashboard").show();
}
else if(role === "EMPLOYEE"){
    // only dashboard
    $("#mastersToggle").hide();
    $("#menuCCA").hide();
    $("#menuReports").hide();
    $("#menuOfficer").show();
    $("#menuReporting").show();
    $("#menuReviewing").show();
    $("#menuAccepting").show();
    $("#menuDashboard").hide();
}
/* username */

var name = localStorage.getItem("displayName");

if(name){
$("#headerUsername").html('<i class="fas fa-user-circle"></i> Welcome ' + name);
}

/* active menu */

var path = window.location.pathname.toLowerCase().replace(BASE_URL.toLowerCase(),"");

// Dashboard
if(path.includes("dashboard")){
    $("#menuDashboard").addClass("active");
}

// CCA
if(path.includes("home/cca") || path.includes("cca")){
    $("#menuCCA").addClass("active");
}

// Reports
if(path.includes("reports")){
    $("#menuReports").addClass("active");
}

// Officer
if(path.includes("home/officer") || path.includes("officer")){
    $("#menuOfficer").addClass("active");
}

if(path.includes("home/reporting") || path.includes("reporting")){
    $("#menuReporting").addClass("active");
}

if(path.includes("home/reviewing") || path.includes("reviewing")){
    $("#menuReviewing").addClass("active");
}

if(path.includes("home/accepting") || path.includes("accepting")){
    $("#menuAccepting").addClass("active");
}

// Masters submenu
if(path.includes("masters")){
    $("#mastersToggle").addClass("active");
    $("#mastersSubmenu").addClass("show");

    // Mark individual submenu active
    if(path.includes("masters/designation")){
        $("#menuMastersDesignation").addClass("active");
    }
    else if(path.includes("masters/state")){
        $("#menuMastersState").addClass("active");
    }
    else if(path.includes("masters/zone")){
        $("#menuMastersZone").addClass("active");
    }
    else if(path.includes("masters/circle")){
        $("#menuMastersCircle").addClass("active");
    }
    else if(path.includes("masters/division")){
        $("#menuMastersDivision").addClass("active");
    }
    else if(path.includes("masters/subdivision")){
        $("#menuMastersSubDivision").addClass("active");
    }
    else if(path.includes("masters/addemployee")){
        $("#menuMastersAddEmployee").addClass("active");
    }
}

/* toggle */

$("#mastersToggle").click(function(){
$(this).toggleClass("active");
$("#mastersSubmenu").toggleClass("show");
});

$("#toggleSidebar").click(function(){
$(".sidebar").toggleClass("collapsed");
});

});

/* logout */

function logoutUser(){

var token = localStorage.getItem("token");

$.ajax({

url: BASE_URL + "api/auth/logout",
method:"POST",

headers:{
"Authorization":"Bearer "+token
},

complete:function(){

localStorage.clear();
sessionStorage.clear();
document.cookie="jwt_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
window.location = BASE_URL + "Login/UserAuth";

}

});

}

</script>

</body>
</html>
