@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
<title>ACR Portal | Login</title>

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">

<style>

body{
margin:0;
height:100vh;
background-image:url('/assets/image/haryana_power.jpg');
background-size:cover;
background-position:center;
background-repeat:no-repeat;
}

/* HEADER */

.header{
background:white;
height:70px;
display:flex;
align-items:center;
padding:0 30px;
box-shadow:0 2px 8px rgba(0,0,0,0.1);
}

.logo{
height:40px;
}

/* MAIN */

.main-container{
height:calc(100vh - 70px);
display:flex;
align-items:center;
justify-content:center;
}

/* LOGIN CARD */

.auth-container{
width:400px;
background:white;
padding:35px;
border-radius:15px;
box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

.hidden{
display:none;
}

#errMsg{
min-height:20px;
}

.forgot-link{
font-size:13px;
cursor:pointer;
color:#007bff;
}

.forgot-link:hover{
text-decoration:underline;
}

.btn-custom{
background:#004a99;
color:white;
border:none;
}

.btn-custom:hover{
background:#0056b3;
}

</style>
</head>

<body>

<!-- HEADER -->

<div class="header">
<img src="~/assets/image/dhbvn_logo.png" class="logo">
</div>

<!-- MAIN LOGIN -->

<div class="main-container">

<div class="auth-container">

<h4 class="text-center mb-4" id="headerTitle">Login</h4>

<!-- STEP 1 -->

<div id="authStep1">

<div class="form-group">
<input type="text" id="loginId" class="form-control" placeholder="Enter Login ID">
</div>

<div class="form-group">
<input type="password" id="pwd" class="form-control" placeholder="Enter Password">
</div>

<div class="text-right mb-3">
<span class="forgot-link" onclick="showForgot()">Forgot Password?</span>
</div>

<button class="btn btn-custom btn-block" onclick="doStep1()">Get OTP</button>

</div>

<!-- STEP 2 -->

<div id="authStep2" class="hidden">

<p class="text-muted small">Enter the OTP sent to your registered mobile/email.</p>

<div class="form-group">
<input type="text" id="otpCode" class="form-control" placeholder="Enter OTP" maxlength="6">
</div>

<button class="btn btn-success btn-block" onclick="doStep2()">Verify & Login</button>

<button class="btn btn-link btn-block" onclick="resetToStep1()">Back</button>

</div>

<!-- FORGOT PASSWORD -->

<div id="forgotSection" class="hidden">

<p class="small text-muted">Enter your Login ID to reset password.</p>

<div class="form-group">
<input type="text" id="forgotUser" class="form-control" placeholder="Enter Login ID">
</div>

<button class="btn btn-primary btn-block" onclick="sendReset()">Send Reset Link</button>

<button class="btn btn-link btn-block" onclick="backToLogin()">Back to Login</button>

</div>

<!-- LOADING -->

<div id="loadingMsg" class="hidden text-center mt-3">
<div class="spinner-border spinner-border-sm text-primary"></div>
<span class="ml-2 small">Please wait...</span>
</div>

<div id="errMsg" class="text-danger small mt-3 text-center"></div>

</div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>

/* TOASTR */

toastr.options={
positionClass:"toast-top-right",
timeOut:"5000",
progressBar:true
};

var apiBaseUrl='@Url.Content("~/api/user/")';

/* LOADING */

function setLoading(on){

if(on){
$("#loadingMsg").removeClass("hidden");
$("button").prop("disabled",true);
}
else{
$("#loadingMsg").addClass("hidden");
$("button").prop("disabled",false);
}

}

/* ERROR */

function showError(msg){
$("#errMsg").text(msg||"");
}

/* SAFE JSON PARSER */

function tryParseJson(text){
try{ return JSON.parse(text);}
catch(e){ return null;}
}

/* RESET */

function resetToStep1(){

$("#authStep2").addClass("hidden");
$("#authStep1").removeClass("hidden");

}

/* LOGIN STEP 1 */

function doStep1(){

showError("");

var loginId=$.trim($("#loginId").val());
var password=$("#pwd").val();

if(!loginId || !password){

showError("Please enter Login ID and Password.");
toastr.error("Please enter Login ID and Password");
return;

}

setLoading(true);

$.ajax({

url:apiBaseUrl+"login/step1",
method:"POST",
contentType:"application/json",
data:JSON.stringify({LoginId:loginId,Password:password}),

complete:function(xhr){

setLoading(false);

var res=tryParseJson(xhr.responseText);

if(res && res.Success){

toastr.success("OTP sent successfully");

$("#authStep1").addClass("hidden");
$("#authStep2").removeClass("hidden");

}
else if(res && res.Message){

showError(res.Message);
toastr.error(res.Message);

}
else{

showError("Server error");
toastr.error("Server error");

}

}

});

}

/* LOGIN STEP 2 */

function doStep2(){
debugger;
showError("");

var loginId=$.trim($("#loginId").val());
var otp=$.trim($("#otpCode").val());

if(!otp){

showError("Enter OTP");
return;

}

setLoading(true);

$.ajax({

url:apiBaseUrl+"login/step2",
method:"POST",
contentType:"application/json",
data:JSON.stringify({LoginId:loginId,Otp:otp}),

complete:function(xhr){

setLoading(false);

var res=tryParseJson(xhr.responseText);

if(res && res.Success){

var token = res.Data.Token;
debugger;
localStorage.setItem("token", token);
localStorage.setItem("displayName", res.Data.DisplayName);
localStorage.setItem("role", res.Data.SystemRole);
localStorage.setItem("tokenExpiry", res.Data.ExpiresAt);

window.location.href="/Home/Dashboard";
document.cookie="jwt_token="+token+"; path=/; SameSite=Strict";
toastr.success("Login successful");

setTimeout(function(){

window.location.href="/Home/Dashboard";

},1000);

}
else if(res && res.Message){

showError(res.Message);
toastr.error(res.Message);

}
else{

showError("Server error");
toastr.error("Server error");

}

}

});

}

/* ENTER KEY */

$("#pwd").keypress(function(e){
if(e.which==13) doStep1();
});

$("#otpCode").keypress(function(e){
if(e.which==13) doStep2();
});

/* FORGOT PASSWORD UI */

function showForgot(){

$("#authStep1").addClass("hidden");
$("#forgotSection").removeClass("hidden");
$("#headerTitle").text("Reset Password");

}

function backToLogin(){

$("#forgotSection").addClass("hidden");
$("#authStep1").removeClass("hidden");
$("#headerTitle").text("Login");

}

function sendReset(){
var loginId = $("#forgotUser").val();

if(!loginId){
alert("Enter Login ID");
return;
}

$.ajax({

url: apiBaseUrl + "forgot-password",
method: "POST",
contentType: "application/json",

data: JSON.stringify({
LoginId: loginId
}),

success:function(res){

if(res.Success){

alert(res.Message);

}
else{

alert(res.Message);

}

},

error:function(){
alert("Request failed");
}

});
// alert("Reset link sent (demo)");

}

</script>

</body>
</html>