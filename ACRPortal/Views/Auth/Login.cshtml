@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>ACR Portal | Secure Login</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            background: #e9ecef;
            height: 100vh;
            display: flex;
            align-items: center;
        }

        .auth-container {
            max-width: 400px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .hidden {
            display: none;
        }

        .btn-custom {
            background-color: #004a99;
            color: white;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <h4 class="text-center mb-4" id="headerTitle">Portal Login</h4>

        <div id="authStep1">
            <div class="form-group">
                <input type="text" id="loginId" class="form-control" placeholder="Login ID" value="rahul_99">
            </div>
            <div class="form-group">
                <input type="password" id="pwd" class="form-control" placeholder="Password" value="welcome@123">
            </div>
            <button class="btn btn-custom btn-block" onclick="doStep1()">Get OTP</button>
        </div>

        <div id="authStep2" class="hidden">
            <p class="text-muted small">Enter the 5-digit code sent to you.</p>
            <div class="form-group">
                <input type="text" id="otpCode" class="form-control" placeholder="OTP (12345)">
            </div>
            <button class="btn btn-success btn-block" onclick="doStep2()">Verify & Login</button>
        </div>

        <div id="authSuccess" class="hidden text-center">
            <div class="display-4 text-success">✔</div>
            <h5>Login Successful!</h5>
            <hr>
            <p class="small text-left">Your Session Token:</p>
            <textarea id="tokenOut" class="form-control mb-3" rows="4" readonly></textarea>
            <button class="btn btn-secondary btn-sm" onclick="location.reload()">Back to Login</button>
        </div>

        <div id="errMsg" class="text-danger small mt-3 text-center"></div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function doStep1() {
            const payload = { LoginId: $("#loginId").val(), Password: $("#pwd").val() };
            $.post("/api/user/login/step1", payload, function(res) {
                if(res.Success) {
                    $("#authStep1").addClass("hidden");
                    $("#authStep2").removeClass("hidden");
                    $("#headerTitle").text("OTP Verification");
                } else { $("#errMsg").text(res.Message); }
            }).fail(err => $("#errMsg").text("Step 1 failed. Check API connection."));
        }

        function doStep2() {
            const payload = { LoginId: $("#loginId").val(), Otp: $("#otpCode").val() };
            $.post("/api/user/login/step2", payload, function(res) {
                if(res.Success) {
                    $("#authStep2").addClass("hidden");
                    $("#authSuccess").removeClass("hidden");
                    $("#headerTitle").text("Dashboard Access");
                    $("#tokenOut").val(res.Data.Token);
                } else { $("#errMsg").text(res.Message); }
            }).fail(err => $("#errMsg").text("Step 2 failed. Check SQL Column size (VARCHAR(MAX))."));
        }
    </script>
</body>
</html>