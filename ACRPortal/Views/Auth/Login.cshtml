@{ Layout = null; }

<!DOCTYPE html>
<html>
<head>
    <title>ACR Portal | Login</title>

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

    <style>

        body {
            margin: 0;
            height: 100vh;
            background-image: url('/assets/image/haryana_power.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        /* Header */

        .header {
            background: white;
            height: 70px;
            display: flex;
            align-items: center;
            padding: 0 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .logo {
            height: 40px;
        }

        /* Main container */

        .main-container {
            height: calc(100vh - 70px);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Login Card */

        .auth-container {
            width: 400px;
            background: white;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .hidden {
            display: none;
        }

        #errMsg {
            min-height: 20px;
        }

        .forgot-link {
            font-size: 13px;
            cursor: pointer;
            color: #007bff;
        }

        .forgot-link:hover {
            text-decoration: underline;
        }

    </style>
</head>

<body>

    <!-- HEADER -->

    <div class="header">
        <img src="~/assets/image/dhbvn_logo.png" class="logo">
    </div>

    <!-- LOGIN AREA -->

    <div class="main-container">

        <div class="auth-container">

            <h4 class="text-center mb-4" id="headerTitle">Login</h4>

            <!-- STEP 1 LOGIN -->

            <div id="authStep1">

                <div class="form-group">
                    <input type="text" id="loginId" class="form-control" placeholder="Enter Login ID">
                </div>

                <div class="form-group">
                    <input type="password" id="pwd" class="form-control" placeholder="Enter Password">
                </div>

                <div class="text-right mb-3">
                    <span class="forgot-link" onclick="showForgot()">Forgot Password?</span>
                </div>

                <button class="btn btn-primary btn-block" onclick="doStep1()">Get OTP</button>

            </div>


            <!-- STEP 2 OTP -->

            <div id="authStep2" class="hidden">

                <p class="text-muted small">
                    Enter the OTP sent to your registered mobile/email.
                </p>

                <div class="form-group">
                    <input type="text" id="otpCode" class="form-control" placeholder="Enter OTP">
                </div>

                <button class="btn btn-success btn-block" onclick="doStep2()">
                    Verify & Login
                </button>

            </div>


            <!-- SUCCESS -->

            <div id="authSuccess" class="hidden text-center">

                <div class="display-4 text-success">✔</div>

                <h5>Login Successful!</h5>

                <hr>

                <p class="small text-left">Session Token:</p>

                <textarea id="tokenOut"
                          class="form-control mb-3"
                          rows="4"
                          readonly></textarea>

                <button class="btn btn-secondary btn-sm"
                        onclick="location.reload()">
                    Back to Login
                </button>

            </div>


            <!-- FORGOT PASSWORD -->

            <div id="forgotSection" class="hidden">

                <p class="small text-muted">
                    Enter your Login ID to reset password.
                </p>

                <div class="form-group">
                    <input type="text"
                           id="forgotUser"
                           class="form-control"
                           placeholder="Enter Login ID">
                </div>

                <button class="btn btn-primary btn-block"
                        onclick="sendReset()">
                    Send Reset Link
                </button>

                <button class="btn btn-link btn-block"
                        onclick="backToLogin()">
                    Back to Login
                </button>

            </div>


            <!-- LOADING -->

            <div id="loadingMsg"
                 class="hidden text-center mt-3">

                <div class="spinner-border spinner-border-sm text-primary"></div>

                <span class="ml-2 small">
                    Please wait...
                </span>

            </div>


            <!-- ERROR -->

            <div id="errMsg"
                 class="text-danger small mt-3 text-center">
            </div>

        </div>

    </div>



    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        var apiBaseUrl = '@Url.Content("~/api/")';


        function setLoading(on) {

            if (on) {
                $("#loadingMsg").removeClass("hidden");
                $("button").prop("disabled", true);
            }
            else {
                $("#loadingMsg").addClass("hidden");
                $("button").prop("disabled", false);
            }

        }


        function showError(msg) {
            $("#errMsg").text(msg || "");
        }


        function clearError() {
            $("#errMsg").text("");
        }


        function tryParseJson(text) {
            try { return JSON.parse(text); }
            catch (e) { return null; }
        }



        /* LOGIN STEP 1 */

        function doStep1() {

            clearError();

            var loginId = $.trim($("#loginId").val());
            var password = $("#pwd").val();

            if (!loginId || !password) {
                showError("Please enter Login ID and Password.");
                return;
            }

            setLoading(true);

            $.ajax({

                url: apiBaseUrl + "user/login/step1",
                method: "POST",
                contentType: "application/json",

                data: JSON.stringify({
                    LoginId: loginId,
                    Password: password
                }),

                complete: function (xhr) {

                    setLoading(false);

                    var res = tryParseJson(xhr.responseText);

                    if (res && res.Success) {

                        $("#authStep1").addClass("hidden");
                        $("#authStep2").removeClass("hidden");

                        $("#headerTitle").text("OTP Verification");

                        $("#otpCode").focus();
                    }
                    else {

                        showError(res && res.Message
                            ? res.Message
                            : "Login failed.");

                    }

                }

            });

        }



        /* LOGIN STEP 2 */

        function doStep2() {

            clearError();

            var loginId = $.trim($("#loginId").val());
            var otp = $.trim($("#otpCode").val());

            if (!otp) {
                showError("Please enter the OTP.");
                return;
            }

            setLoading(true);

            $.ajax({

                url: apiBaseUrl + "user/login/step2",
                method: "POST",
                contentType: "application/json",

                data: JSON.stringify({
                    LoginId: loginId,
                    Otp: otp
                }),

                complete: function (xhr) {

                    setLoading(false);

                    var res = tryParseJson(xhr.responseText);

                    if (res && res.Success) {

                        document.cookie =
                            "jwt_token=" + res.Data.Token +
                            "; path=/; SameSite=Strict";

                        $("#authStep2").addClass("hidden");
                        $("#authSuccess").removeClass("hidden");

                        $("#tokenOut").val(res.Data.Token);

                    }
                    else {

                        showError(res && res.Message
                            ? res.Message
                            : "OTP verification failed.");

                    }

                }

            });

        }



        /* FORGOT PASSWORD UI */

        function showForgot() {

            $("#authStep1").addClass("hidden");
            $("#forgotSection").removeClass("hidden");

            $("#headerTitle").text("Reset Password");

        }


        function backToLogin() {

            $("#forgotSection").addClass("hidden");
            $("#authStep1").removeClass("hidden");

            $("#headerTitle").text("Login");

        }


        function sendReset() {

            alert("Password reset link sent (demo)");

        }



        /* ENTER KEY SUPPORT */

        $("#pwd").keypress(function (e) {
            if (e.which === 13) doStep1();
        });

        $("#otpCode").keypress(function (e) {
            if (e.which === 13) doStep2();
        });

    </script>

</body>
</html>