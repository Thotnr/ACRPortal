@{ Layout = null; }

<!DOCTYPE html>
<html>
<head>

<title>ACR Portal | Reset Password</title>

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">

<style>

body{
margin:0;
height:100vh;
background-image:url('/assets/image/haryana_power.jpg');
background-size:cover;
background-position:center;
background-repeat:no-repeat;
}

.header{
background:white;
height:70px;
display:flex;
align-items:center;
padding:0 30px;
box-shadow:0 2px 8px rgba(0,0,0,0.1);
}

.logo{
height:40px;
}

.main-container{
height:calc(100vh - 70px);
display:flex;
align-items:center;
justify-content:center;
}

.auth-container{
width:400px;
background:white;
padding:35px;
border-radius:15px;
box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

.hidden{
display:none;
}

.btn-custom{
background:#004a99;
color:white;
border:none;
}

.btn-custom:hover{
background:#0056b3;
}

</style>

</head>

<body>

<div class="header">
<img src="~/assets/image/dhbvn_logo.png" class="logo">
</div>

<div class="main-container">

<div class="auth-container">

<h4 class="text-center mb-4">Reset Password</h4>

<div class="form-group">
<input type="text" id="loginId" class="form-control" placeholder="Login ID">
</div>

<div class="form-group">
<input type="password" id="newPassword" class="form-control" placeholder="New Password">
</div>

<button class="btn btn-custom btn-block" onclick="resetPassword()">Reset Password</button>

<div id="errMsg" class="text-danger small mt-3 text-center"></div>

</div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>

var apiBaseUrl='@Url.Content("~/api/auth/")';

/* URL PARAM HELPER */

function getParam(name){

const urlParams = new URLSearchParams(window.location.search);
return urlParams.get(name);

}

var resetToken = getParam("token");

/* ERROR */

function showError(msg){
$("#errMsg").text(msg || "");
}

/* RESET PASSWORD */

function resetPassword(){

showError("");

var loginId = $("#loginId").val();
var newPassword = $("#newPassword").val();

if(!loginId || !newPassword){

showError("All fields required");
toastr.error("All fields required");
return;

}

if(!resetToken){

showError("Invalid reset link");
toastr.error("Invalid reset link");
return;

}

$.ajax({

url: apiBaseUrl + "reset-password",
method: "POST",
contentType: "application/json",

data: JSON.stringify({

LoginId: loginId,
ResetToken: resetToken,
NewPassword: newPassword

}),

success:function(res){

if(res.Success){

toastr.success(res.Message);

setTimeout(function(){
window.location.href='@Url.Action("UserAuth","Login")';
},2000);

}
else{

showError(res.Message);
toastr.error(res.Message);

}

},

error:function(){

showError("Server error");
toastr.error("Server error");

}

});

}

</script>

</body>
</html>