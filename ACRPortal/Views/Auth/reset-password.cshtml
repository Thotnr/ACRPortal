@{ Layout = null; }

<!DOCTYPE html>
<html>
<head>

<title>ACR Portal | Reset Password</title>

<link rel="stylesheet" href="@Url.Content("~/assets/js/lib/bootstrap-4-5-2.min.css")">
<link rel="stylesheet" href="@Url.Content("~/assets/js/lib/toastr.min.css")">

<style>

body{
margin:0;
min-height:100vh;
background:
linear-gradient(135deg, rgba(10,24,44,0.82), rgba(29,78,216,0.72)),
url('/assets/image/haryana_power.jpg');
background-size:cover;
background-position:center;
background-repeat:no-repeat;
font-family:'Segoe UI',sans-serif;
}

.header{
background:rgba(255,255,255,0.9);
backdrop-filter:blur(12px);
height:78px;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 28px;
box-shadow:0 14px 30px rgba(15,23,42,0.12);
}

.logo{
height:46px;
display:block;
filter:drop-shadow(0 8px 18px rgba(29,78,216,0.12));
}

.brand-copy{
display:flex;
flex-direction:column;
}

.brand-title{
font-size:18px;
font-weight:700;
line-height:1.1;
color:#102542;
}

.brand-subtitle{
font-size:12px;
font-weight:600;
letter-spacing:.05em;
text-transform:uppercase;
color:#64748b;
}

.main-container{
min-height:calc(100vh - 78px);
display:flex;
align-items:center;
justify-content:center;
padding:32px 20px;
}

.auth-shell{
width:min(1040px, 100%);
display:grid;
grid-template-columns:1fr .88fr;
gap:28px;
align-items:stretch;
}

.auth-hero{
position:relative;
overflow:hidden;
border-radius:30px;
padding:36px;
background:
radial-gradient(circle at top right, rgba(255,255,255,0.16), transparent 28%),
linear-gradient(135deg, rgba(16,37,66,0.9) 0%, rgba(29,78,216,0.82) 58%, rgba(6,182,212,0.76) 100%);
box-shadow:0 30px 60px rgba(10,24,44,0.3);
color:#fff;
}

.hero-kicker{
display:inline-flex;
align-items:center;
gap:8px;
padding:8px 14px;
border-radius:999px;
background:rgba(255,255,255,0.12);
font-size:12px;
font-weight:700;
letter-spacing:.08em;
text-transform:uppercase;
}

.hero-title{
margin:22px 0 12px;
font-size:38px;
font-weight:700;
line-height:1.1;
}

.hero-copy{
max-width:500px;
margin:0;
font-size:15px;
line-height:1.8;
color:rgba(255,255,255,0.84);
}

.hero-note{
margin-top:28px;
padding:18px 20px;
border-radius:20px;
background:rgba(255,255,255,0.08);
border:1px solid rgba(255,255,255,0.1);
line-height:1.7;
}

.auth-container{
width:100%;
max-width:440px;
justify-self:end;
background:rgba(255,255,255,0.96);
padding:34px 32px;
border-radius:28px;
box-shadow:0 24px 50px rgba(10,24,44,0.24);
border:1px solid rgba(255,255,255,0.78);
backdrop-filter:blur(12px);
}

.hidden{
display:none;
}

.auth-title{
font-size:30px;
font-weight:700;
line-height:1.15;
color:#102542;
}

.auth-subtitle{
margin:10px 0 0;
font-size:14px;
line-height:1.7;
color:#667085;
}

.form-control{
min-height:50px;
border-radius:16px;
border:1px solid rgba(15,23,42,0.12);
padding:12px 14px;
}

.form-control:focus{
border-color:#93c5fd;
box-shadow:0 0 0 .2rem rgba(37,99,235,.12);
}

.btn-custom{
background:linear-gradient(135deg, #15314b, #2563eb);
color:white;
border:none;
border-radius:16px;
font-weight:700;
padding:13px 16px;
box-shadow:0 16px 28px rgba(37,99,235,0.22);
}

.btn-custom:hover{
background:linear-gradient(135deg, #102542, #1d4ed8);
color:#fff;
}

@@media (max-width: 991.98px){
    .auth-shell{
        grid-template-columns:1fr;
    }

    .auth-container{
        justify-self:stretch;
        max-width:none;
    }
}

@@media (max-width: 767.98px){
    .header{
        height:auto;
        padding:16px;
    }

    .brand-subtitle{
        display:none;
    }

    .main-container{
        padding:20px 14px;
    }

    .auth-hero,
    .auth-container{
        border-radius:24px;
        padding:24px 22px;
    }
}

</style>

</head>

<body>

<div class="header">
<div class="d-flex align-items-center" style="gap:14px;">
<img src="~/assets/image/dhbvn_logo.png" class="logo">
<div class="brand-copy">
<span class="brand-title">ACR Portal</span>
<span class="brand-subtitle">Performance Workflow System</span>
</div>
</div>
</div>

<div class="main-container">

<div class="auth-shell">

<div class="auth-hero">
<span class="hero-kicker"><i class="fas fa-lock"></i> Password Recovery</span>
<h1 class="hero-title">Reset your password in a cleaner, simpler recovery flow.</h1>
<p class="hero-copy">Use the secure reset link from your email or recovery process to set a new password and get back into the ACR Portal quickly.</p>
<div class="hero-note">
<strong>Quick tip:</strong> enter the same login ID connected to the reset request, then choose your new password to complete recovery.
</div>
</div>

<div class="auth-container">

<div class="mb-4">
<h4 class="auth-title">Reset Password</h4>
<p class="auth-subtitle">Enter your login ID and set a new password to continue.</p>
</div>

<div class="form-group">
<input type="text" id="loginId" class="form-control" placeholder="Login ID">
</div>

<div class="form-group">
<input type="password" id="newPassword" class="form-control" placeholder="New Password">
</div>

<button class="btn btn-custom btn-block" onclick="resetPassword()">Reset Password</button>

<div id="errMsg" class="text-danger small mt-3 text-center"></div>

</div>

</div>
</div>

<script src="@Url.Content("~/assets/js/lib/jquery-3.7.1.min.js")"></script>
<script src="@Url.Content("~/assets/js/lib/toastr.min.js")"></script>

<script>

var apiBaseUrl='@Url.Content("~/api/auth/")';

/* URL PARAM HELPER */

function getParam(name){

const urlParams = new URLSearchParams(window.location.search);
return urlParams.get(name);

}

var resetToken = getParam("token");

/* ERROR */

function showError(msg){
$("#errMsg").text(msg || "");
}

/* RESET PASSWORD */

function resetPassword(){

showError("");

var loginId = $("#loginId").val();
var newPassword = $("#newPassword").val();

if(!loginId || !newPassword){

showError("All fields required");
toastr.error("All fields required");
return;

}

if(!resetToken){

showError("Invalid reset link");
toastr.error("Invalid reset link");
return;

}

$.ajax({

url: apiBaseUrl + "reset-password",
method: "POST",
contentType: "application/json",

data: JSON.stringify({

LoginId: loginId,
ResetToken: resetToken,
NewPassword: newPassword

}),

success:function(res){

if(res.Success){

toastr.success(res.Message);

setTimeout(function(){
window.location.href='@Url.Action("UserAuth","Login")';
},2000);

}
else{

showError(res.Message);
toastr.error(res.Message);

}

},

error:function(){

showError("Server error");
toastr.error("Server error");

}

});

}

</script>

</body>
</html>
